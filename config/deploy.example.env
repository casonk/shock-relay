# Copy to config/deploy.local.env (gitignored) to choose how the digest sender runs. Nothing here is required:
# without it, deploy/deploy.sh uses "dev". See docs/deployment.md.
#
#   dev   send the queued digest once, in the foreground: Python only, no systemd, no cluster
#   host  the Clockwork-managed systemd user timer shock-relay-gmail-digest.timer (hourly)
#   k3s   a CronJob in K3s with default-deny egress (needs K3s, podman and the in-cluster registry)
SHOCK_RELAY_DEPLOY_MODE=dev
